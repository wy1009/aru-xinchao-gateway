[Unit]
Description=Import the selected Aru collaborator backup into PaiMem
Wants=nian-paimem.service
After=nian-paimem.service
[Service]
Type=oneshot
User=aru-inbox
Group=aru-inbox
StateDirectory=aru-backup-inbox
StateDirectoryMode=0700
LoadCredential=paimem-key:/etc/xinchao-nian/paimem-key
EnvironmentFile=/etc/xinchao-nian/paimem-owner.env
ExecStart=/opt/xinchao-nian/venv/bin/python -B /opt/xinchao-nian/aru-inbox/paimem_backup.py
TimeoutStartSec=infinity
UMask=0077
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
