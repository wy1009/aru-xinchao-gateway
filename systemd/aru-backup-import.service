[Unit]
Description=Sync the uploaded Aru backup to OB
Wants=nian-ob.service
After=nian-ob.service

[Service]
Type=oneshot
User=aru-inbox
Group=aru-inbox
StateDirectory=aru-backup-inbox
StateDirectoryMode=0700
LoadCredential=gateway-internal:/etc/xinchao-nian/gateway-internal
ExecStart=/opt/xinchao-nian/venv/bin/python -B /opt/xinchao-nian/aru-inbox/aru_portal_worker.py
TimeoutStartSec=infinity
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectProc=invisible
