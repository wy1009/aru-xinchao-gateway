+  async recentAruDreamMaterial(recentDreams) {
+    const url = new URL('/internal/aru-backup/dream-material', this.config.url);
+    const response = await fetch(url, {
+      headers: { Authorization: `Bearer ${this.config.token}`, Accept: 'application/json' },
+      signal: AbortSignal.timeout(10000),
+    });
+    if (!response.ok) throw new Error(`Aru dream material: HTTP ${response.status}`);
+    const { memories } = await response.json();
+    const used = new Set(recentDreams.slice(-2).flatMap((d) => d.sourceOmbreBucketIds ?? []));
+    // Both lists retain the source-conversation order returned by OB, newest first.
+    const picked = [...memories.filter((m) => !used.has(m.id)), ...memories.filter((m) => used.has(m.id))].slice(0, 2);
+    return {
+      text: picked.map((m) => `${m.period}\n${m.text}`).join('\n\n'),
+      bucketIds: picked.map((m) => m.id),
+    };
