diff --git a/xinchao/test/dream-material-eligibility.test.js b/xinchao/test/dream-material-eligibility.test.js
new file mode 100644
index 0000000..1e01f36
--- /dev/null
+++ b/xinchao/test/dream-material-eligibility.test.js
@@ -0,0 +1,36 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { OmbreClient } from '../src/ombre-client.js';
+
+test('dream sources are rebuilt only from verified previews, in rank order', async t => {
+  const client = new OmbreClient({ url: 'http://ob.test/mcp', readEnabled: true });
+  const reads = [];
+  t.mock.method(globalThis, 'fetch', async url => {
+    assert.equal(url.searchParams.get('purpose'), 'dream');
+    const id = url.pathname.split('/').at(-1);
+    reads.push(id);
+    if (id === 'hidden') return new Response(null, {status: 404});
+    // A sidecar from before the upgrade returns a normal, unverified preview.
+    const data = {id, preview: id === 'unverified' ? 'old dream' : 'verified original'};
+    if (id !== 'unverified') data.dreamEligible = true;
+    return Response.json(data);
+  });
+  client.call = async () => ({content:[{type:'text', text:
+    'preamble\n[first] 主题:感情 V0.5/A0.5 创建:x\nID: hidden\nold dream\n---\n' +
+    '[second] 主题: V0.4/A0.3 创建:x\nID: aru_nonhex\ncontaminated snippet\n---\n' +
+    '[third] 主题:亲密 V0.4/A0.3 创建:x\nID: unverified\nlegacy preview'}]});
+  const digest = await client.digestMaterial();
+  assert.equal(digest.total, 3);
+  assert.deepEqual(digest.bucketIds, ['aru_nonhex']);
+  assert.equal(digest.kept, 1);
+  assert.match(digest.text, /verified original/);
+  assert.doesNotMatch(digest.text, /old dream|contaminated|legacy preview/);
+  assert.deepEqual(reads, ['hidden','aru_nonhex','unverified']);
+  const recent = await client.dreamMaterialForIds(['hidden','unverified','aru_nonhex','aru_nonhex']);
+  assert.deepEqual(recent.bucketIds, ['aru_nonhex']);
+  assert.match(recent.text, /verified original/);
+  client.breathAdvanced = async () => ({content:[{type:'text',text:'[bucket_id:hidden]\nold dream'}]});
+  assert.equal((await client.farMaterial()).text, '');
+  assert.equal((await client.dreamMaterialForIds([])).text, '');
+  assert.equal((await client.dreamMaterialForIds(['hidden','unverified'])).text, '');
+});
