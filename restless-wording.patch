diff --git a/xinchao/src/restless-wording.js b/xinchao/src/restless-wording.js
new file mode 100644
index 0000000..41f3613
--- /dev/null
+++ b/xinchao/src/restless-wording.js
@@ -0,0 +1,59 @@
+// Normalize the service's own labels and generated text. User quotes and event IDs are data.
+export const restlessLine = '刚才的事过去了，心里还没平静下来。';
+const oldLabel = '烦躁';
+const label = '心绪不宁';
+
+export function emotionWording(text) {
+  return typeof text === 'string' ? text.replaceAll(oldLabel, label) : text;
+}
+
+function renameLabel(item, field = 'label') {
+  if (item?.[field] === oldLabel) item[field] = label;
+}
+
+function updateText(item, fields) {
+  for (const key of fields) {
+    if (typeof item?.[key] === 'string') item[key] = emotionWording(item[key]);
+  }
+}
+
+export function normalizeMindWording(state) {
+  renameLabel(state.emotion);
+  renameLabel(state.emotion?.pendingLabel);
+  renameLabel(state.selfSignals?.emotionEpisode);
+  for (const sample of state.emotionJournal ?? []) renameLabel(sample);
+  for (const mark of state.emotionMarks ?? []) renameLabel(mark, 'word');
+  for (const day of Object.values(state.emotionDays ?? {})) {
+    if (day.labels && Object.hasOwn(day.labels, oldLabel)) {
+      day.labels[label] = (day.labels[label] ?? 0) + day.labels[oldLabel];
+      delete day.labels[oldLabel];
+    }
+  }
+  for (const entry of state.selfSignals?.history ?? []) {
+    if (entry.kind === 'emotion_shift' && entry.subject === oldLabel) {
+      entry.subject = label;
+      entry.text = restlessLine;
+    } else {
+      updateText(entry, ['text']);
+    }
+  }
+  for (const dream of state.recentDreams ?? []) {
+    updateText(dream, ['dream', 'residue', 'awareness', 'summary', 'image']);
+  }
+  updateText(state.pendingAwareness, ['residue']);
+  return state;
+}
+
+// A queued event keeps its deduplication key and receipt state, even across an upgrade.
+export function normalizeQueueWording(queue) {
+  for (const item of queue.deliveries ?? []) {
+    if (item.reason !== 'self_signal') continue;
+    if (item.eventId?.startsWith('self-emotion_shift-烦躁-')) {
+      const suffix = /\s此刻：[\s\S]*$/u.exec(item.message)?.[0] ?? '';
+      item.message = restlessLine + emotionWording(suffix);
+    } else {
+      updateText(item, ['message']);
+    }
+  }
+  return queue;
+}
