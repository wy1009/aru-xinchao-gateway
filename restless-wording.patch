diff --git a/xinchao/test/restless-wording.test.js b/xinchao/test/restless-wording.test.js
new file mode 100644
index 0000000..a9a2489
--- /dev/null
+++ b/xinchao/test/restless-wording.test.js
@@ -0,0 +1,46 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { normalizeMindWording, normalizeQueueWording, restlessLine } from '../src/restless-wording.js';
+import { newState } from '../src/engine.js';
+import { emotionSummary } from '../src/emotion.js';
+import { buildDashboardSnapshot } from '../src/dashboard-projection.js';
+import { buildContextEnvelope } from '../src/context-envelope.js';
+import { ModelClient } from '../src/model-client.js';
+
+test('legacy episode, trend and dream keep their meaning across dashboard, context and dream generation', async () => {
+  const now = new Date(), state = newState(now);
+  Object.assign(state.emotion, { label: '烦躁', valence: 0.2, arousal: 0.8 });
+  state.emotion.pendingLabel = {label: '烦躁', since: now.toISOString()};
+  state.emotionDays = {today: {labels: {'烦躁': 4, '心绪不宁': 1}}};
+  state.emotionJournal = [{at: now.toISOString(), label:'烦躁', valence:0.2, arousal:0.8}];
+  state.selfSignals = {emotionEpisode: {label:'烦躁', signaled:true}, history:[{kind:'emotion_shift', subject:'烦躁', text:'静不下来，争执那口气还没散。'}]};
+  state.recentDreams = [{id:'dream1', residue:'有点烦躁'}];
+  normalizeMindWording(state);
+  const once = structuredClone(state);
+  normalizeMindWording(state);
+  assert.deepEqual(state, once);
+  assert.deepEqual(state.emotionDays.today.labels, {'心绪不宁':5});
+  assert.deepEqual(state.selfSignals.emotionEpisode, {label:'心绪不宁', signaled:true});
+  const view = buildDashboardSnapshot(state, {}, now);
+  assert.equal(view.emotion.journal[0].label, '心绪不宁');
+  assert.equal(view.signals.recent[0].text, restlessLine);
+  const ctx = await buildContextEnvelope({state, mode:'turn', now});
+  assert.match(JSON.stringify(ctx), /心绪不宁/);
+  assert.doesNotMatch(JSON.stringify(ctx), /烦躁/);
+  const model = new ModelClient({enabled:true, apiKey:'fixture', maxInputChars:2000});
+  model.request = async body => {
+    assert.match(body.messages.at(-1).content, /入睡时的心情：心绪不宁/);
+    return {ok:true,json:async()=>({choices:[{message:{content:JSON.stringify({dream:'有些烦躁',residue:'烦躁'})}}]})};
+  };
+  const dream = await model.generateDream({state, emotion:emotionSummary(state,now), topDrives:[]});
+  assert.equal(dream.residue, '心绪不宁');
+  assert.equal(dream.dream, '有些心绪不宁');
+});
+
+test('queued wakes keep receipt identity and authored letters keep their words', () => {
+  const eventId='self-emotion_shift-烦躁-1';
+  const queue={deliveries:[{eventId, reason:'self_signal', status:'delivered', message:'争执那口气还没散。 此刻：情绪 烦躁'}, {reason:'user_note',message:'我有点烦躁'}]};
+  normalizeQueueWording(queue);
+  assert.deepEqual(queue.deliveries[0], {eventId,reason:'self_signal',status:'delivered',message:restlessLine+' 此刻：情绪 心绪不宁'});
+  assert.equal(queue.deliveries[1].message, '我有点烦躁');
+});
